{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "simple": {
            "format": "%(asctime)s | %(levelname)-8s | %(name)s | %(message)s"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "level": "INFO",
            "formatter": "simple",
            "stream": "ext://sys.stdout"
        },
        "tictactoe_file": {
            "class": "logging.FileHandler",
            "level": "DEBUG",
            "formatter": "simple",
            "filename": "logs/tictactoe.log",
            "mode": "a"
        },
        "tictactoe_rl_file": {
            "class": "logging.FileHandler",
            "level": "DEBUG",
            "formatter": "simple",
            "filename": "logs/tictactoe_rl.log",
            "mode": "a"
        }
    },
    "loggers": {
        "tictactoe": {
            "level": "DEBUG",
            "handlers": ["console", "tictactoe_file"],
            "propagate": false
        },
        "tictactoe_rl": {
            "level": "DEBUG",
            "handlers": ["console", "tictactoe_rl_file"],
            "propagate": false
        }
    },
    "root": {
        "level": "WARNING",
        "handlers": ["console"]
    }
}
